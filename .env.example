# Número de WhatsApp de Max, solo dígitos con código de país (sin + ni espacios)
PUBLIC_WHATSAPP_MAX=

# Google Sheets (solo servidor). Cuenta de servicio con acceso de editor a la hoja.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Llave privada de la cuenta de servicio, en una sola línea con "\n" literales
GOOGLE_PRIVATE_KEY=
# ID de la hoja (el texto largo entre /d/ y /edit en su URL)
GOOGLE_SHEET_ID=
