---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/brand/kamikaze-logo-provisional.png';
import { home } from '../content/home';
---

<Base title={home.meta.title} description={home.meta.description}>
  <header class="top">
    <p class="mark">Max / Kamikaze</p>
    <h1>{home.heading}</h1>
  </header>

  <main id="contenido" class="selector">
    {
      home.options.map((o) => (
        <a class="panel" data-brand={o.id} href={o.href}>
          <span class="kind">{o.kind}</span>
          {o.id === 'kamikaze' && (
            <Image
              class="logo"
              src={logo}
              alt="Logo de Kamikaze Colombia (provisional)"
              width={96}
              height={96}
              loading="eager"
            />
          )}
          <span class="body">
            <h2 class="name">{o.name}</h2>
            <span class="text">{o.text}</span>
            <span class="action">{o.action}</span>
          </span>
        </a>
      ))
    }
  </main>

  <Footer />
</Base>

<style>
  .top {
    padding: 20px 20px 24px;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .mark {
    margin: 0 0 28px;
    font-size: 15px;
    font-weight: 800;
    font-stretch: 62%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.6rem, 11vw, 5.5rem);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.92;
  }

  .selector {
    display: grid;
  }

  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    min-height: clamp(440px, 70svh, 620px);
    padding: 20px;
    container-type: inline-size;
    background: var(--brand-bg);
    color: var(--brand-fg);
    text-decoration: none;
  }
  .panel:focus-visible {
    outline-offset: -6px;
  }

  .kind {
    max-width: 22ch;
    font-size: 17px;
    font-weight: 600;
    color: var(--brand-muted);
  }
  .logo {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 50%;
  }

  .body {
    display: grid;
    gap: 16px;
  }
  .name {
    margin: 0 0 4px;
    font-size: 40cqi;
    font-weight: var(--brand-display-weight);
    font-stretch: var(--brand-stretch);
    line-height: 0.82;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
  .panel[data-brand='max'] .name {
    letter-spacing: 0.01em;
  }
  .panel[data-brand='kamikaze'] .name {
    font-size: 26cqi;
  }
  .text {
    max-width: 34ch;
    font-size: 18px;
    line-height: 1.45;
  }
  .action {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 22px;
    background: var(--brand-signal);
    color: var(--brand-on-signal);
    font-size: 17px;
    font-weight: 700;
  }
  .panel:hover .action {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 900px) {
    .top {
      display: flex;
      align-items: end;
      justify-content: space-between;
      padding: 24px 40px 28px;
    }
    .mark {
      margin: 0;
      order: 2;
    }
    h1 {
      max-width: none;
      font-size: clamp(3rem, 5.5vw, 5rem);
    }
    .selector {
      grid-template-columns: 1fr 1fr;
      min-height: calc(100svh - 150px);
      transition: grid-template-columns 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .selector:has(.panel[data-brand='max']:is(:hover, :focus-visible)) {
      grid-template-columns: 1.3fr 0.7fr;
    }
    .selector:has(.panel[data-brand='kamikaze']:is(:hover, :focus-visible)) {
      grid-template-columns: 0.7fr 1.3fr;
    }
    .panel {
      min-height: 0;
      padding: 32px 40px;
    }
    .logo {
      top: 28px;
      right: 40px;
      width: 88px;
      height: 88px;
    }
  }
</style>
