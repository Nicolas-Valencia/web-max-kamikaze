---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import RefPhoto from '../components/RefPhoto.astro';
import heroPhoto from '../assets/reference/home-hero.jpg';
import maxPhoto from '../assets/reference/max-portrait.jpg';
import kamikazePhoto from '../assets/reference/gallery-4.jpg';
import { home as c } from '../content/home';

const photos = { max: maxPhoto, kamikaze: kamikazePhoto } as const;
const positions = { max: '50% 18%', kamikaze: '50% 40%' } as const;
---

<Base title={c.meta.title} description={c.meta.description}>
  <SiteHeader brand="home" links={c.nav} cta={c.cta} />

  <main id="contenido">
    <section class="hero" aria-labelledby="titular">
      <div class="hero-photo" aria-hidden="false">
        <RefPhoto
          src={heroPhoto}
          alt="Dos peleadores de Muay Thai en un ring"
          fill
          color
          eager
          position="30% 30%"
          tag="bottom-right"
        />
      </div>

      <div class="wrap hero-body">
        <p class="eyebrow">{c.hero.kicker}</p>
        <h1 id="titular" class="display">
          {
            c.hero.lines.map((line, i) => (
              <span class:list={['line', { accent: i === c.hero.accentLine }]}>{line}</span>
            ))
          }
        </h1>
        <p class="lead">{c.hero.text}</p>
        <div class="actions">
          <a class="btn btn-primary btn-down" href="#elige">{c.hero.action}</a>
          <span class="mono coord">{c.hero.coord}</span>
        </div>
      </div>
    </section>

    <section id={c.select.id} class="wrap block" aria-labelledby="elige-titulo">
      <SectionHead
        id="elige-titulo"
        eyebrow="División técnica"
        title={c.select.title}
        accent={c.select.accent}
      />
      <div class="panels">
        {
          c.select.options.map((o) => (
            <a class="panel" href={o.href}>
              <div class="panel-photo">
                <RefPhoto
                  src={photos[o.id]}
                  alt=""
                  fill
                  position={positions[o.id]}
                  tag="bottom-right"
                />
              </div>
              <div class="panel-shade" aria-hidden="true" />
              <div class="panel-top">
                <span class="mono index">{o.index}</span>
                <span class="mono tag">{o.tag}</span>
              </div>
              <div class="panel-body">
                <span class="mono kind">{o.kind}</span>
                <h3 class="display name">{o.name}</h3>
                <p class="text">{o.text}</p>
                <div class="panel-foot">
                  <span class="go">{o.action}</span>
                  <span class="mono meta">{o.meta}</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="values" aria-label="Por qué elegirnos">
      <div class="wrap grid">
        {
          c.values.map((v, i) => (
            <div class="value">
              <p class="mono label">{`0${i + 1}. ${v.label}`}</p>
              <h3 class="display">{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  main {
    background: var(--color-ink);
  }

  /* Portada con foto */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(88svh, 820px);
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
  }
  /* Móvil: la foto ocupa la parte alta, sin quedar detrás del texto */
  .hero-photo {
    position: absolute;
    inset: 0 0 38% 0;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  /* El recorte de referencia es muy oscuro: se aclara para que la foto se vea. */
  .hero-photo :global(img) {
    filter: brightness(3.2) contrast(1.1) saturate(1.1) blur(0.7px) !important;
    object-position: 35% 22% !important;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-ink) 6%,
      rgba(10, 10, 10, 0.72) 42%,
      rgba(10, 10, 10, 0.25) 100%
    );
    pointer-events: none;
  }
  .hero-body {
    position: relative;
    z-index: 2;
    padding-block: 120px 56px;
  }
  .hero-body .eyebrow {
    color: var(--color-subtle);
  }
  h1 {
    display: grid;
    margin-bottom: 24px;
    font-size: clamp(3.2rem, 17.5vw, 10rem);
    line-height: 0.86;
  }
  .lead {
    max-width: 52ch;
    margin: 0 0 32px;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(242, 240, 235, 0.82);
  }
  .actions {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .actions .btn {
    width: 100%;
  }
  .coord {
    max-width: 100%;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  /* Selector: dos paneles con foto */
  .panels {
    display: grid;
    gap: 16px;
  }
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-height: 540px;
    padding: 24px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    color: var(--color-bone);
    text-decoration: none;
  }
  .panel:hover {
    border-color: var(--color-signal);
  }
  .panel-photo {
    position: absolute;
    inset: 0;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .panel:hover .panel-photo {
    transform: scale(1.04);
  }
  .panel-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.96) 12%, rgba(10, 10, 10, 0.5) 62%, rgba(10, 10, 10, 0.6));
  }
  .panel-top,
  .panel-body {
    position: relative;
    z-index: 2;
  }
  .panel-top {
    display: grid;
    justify-items: start;
    gap: 8px;
  }
  .index {
    color: var(--color-signal);
    font-weight: 700;
  }
  .tag {
    padding: 3px 8px;
    border: 1px solid rgba(242, 240, 235, 0.35);
    background: rgba(10, 10, 10, 0.6);
    font-size: 10px;
  }
  .kind {
    color: var(--color-subtle);
  }
  .name {
    margin: 6px 0 12px;
    font-size: clamp(4rem, 16vw, 6.4rem);
  }
  .text {
    max-width: 40ch;
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.55;
    color: rgba(242, 240, 235, 0.85);
  }
  .panel-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(242, 240, 235, 0.25);
  }
  .go {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .go::after {
    content: ' →';
    font-family: var(--font-sans);
  }
  .meta {
    color: var(--color-muted);
  }

  /* Tres razones */
  .values {
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .values .grid {
    display: grid;
    gap: 0;
    padding-block: 24px;
  }
  .value {
    padding-block: 28px;
    border-top: 1px solid var(--color-line);
  }
  .value:first-child {
    border-top: 0;
  }
  .label {
    margin: 0 0 10px;
    color: var(--color-signal);
  }
  .value h3 {
    margin-bottom: 8px;
    font-size: 2.2rem;
    line-height: 1;
  }
  .value p:last-child {
    max-width: 40ch;
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    /* Escritorio: la foto a la derecha, sin ampliarla más de lo que su resolución aguanta */
    .hero-photo {
      inset: 0 0 0 auto;
      width: min(54%, 760px);
      mask-image: linear-gradient(to right, transparent 0%, #000 42%);
    }
    .hero::after {
      background:
        linear-gradient(to right, var(--color-ink) 36%, rgba(10, 10, 10, 0.55) 56%, rgba(10, 10, 10, 0.1) 100%),
        linear-gradient(to top, var(--color-ink) 2%, transparent 40%);
    }
    .hero-body {
      padding-block: 160px 72px;
    }
    h1 {
      font-size: clamp(6rem, 13vw, 11.5rem);
    }
    .actions {
      grid-auto-flow: column;
      align-items: center;
      justify-content: start;
      gap: 32px;
    }
    .actions .btn {
      width: auto;
    }
    .panels {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .panel {
      min-height: 680px;
      padding: 32px;
    }
    .values .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
      padding-block: 48px;
    }
    .value {
      border-top: 0;
      padding-block: 0;
    }
  }
</style>
