---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import RefPhoto from '../components/RefPhoto.astro';
import heroPhoto from '../assets/reference/home-hero.jpg';
import maxPhoto from '../assets/reference/max-portrait.jpg';
import kamikazePhoto from '../assets/reference/gallery-4.jpg';
import { home as c } from '../content/home';

const photos = { max: maxPhoto, kamikaze: kamikazePhoto } as const;
const positions = { max: '50% 18%', kamikaze: '50% 40%' } as const;
---

<Base title={c.meta.title} description={c.meta.description}>
  <SiteHeader brand="home" links={c.nav} cta={c.cta} />

  <main id="contenido">
    <section class="hero" aria-labelledby="titular">
      <div class="hero-photo" aria-hidden="false">
        <RefPhoto
          src={heroPhoto}
          alt="Dos peleadores de Muay Thai en un ring"
          fill
          color
          eager
          position="30% 30%"
          tag="bottom-right"
        />
      </div>

      <div class="wrap hero-body">
        <p class="eyebrow">{c.hero.kicker}</p>
        <h1 id="titular" class="display">
          {
            c.hero.lines.map((line, i) => (
              <span class:list={['line', { accent: i === c.hero.accentLine }]}>{line}</span>
            ))
          }
        </h1>
        <p class="lead">{c.hero.text}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#elige">{c.hero.action}</a>
          <span class="mono coord">{c.hero.coord}</span>
        </div>
      </div>
    </section>

    <section id={c.select.id} class="select" aria-labelledby="elige-titulo">
      <h2 id="elige-titulo" class="sr-only">{c.select.title} {c.select.accent}</h2>
      <div class="panels">
        {
          c.select.options.map((o) => (
            <a class="panel" href={o.href}>
              <div class="panel-photo">
                <RefPhoto
                  src={photos[o.id]}
                  alt=""
                  fill
                  position={positions[o.id]}
                  tag="bottom-right"
                />
              </div>
              <div class="panel-shade" aria-hidden="true" />
              <div class="panel-top">
                <span class="mono tag">{o.tag}</span>
              </div>
              <div class="panel-body">
                <span class="mono kind">{o.kind}</span>
                <h3 class="display name">{o.name}</h3>
                <p class="text">{o.text}</p>
                <div class="panel-foot">
                  <span class="go">{o.action}</span>
                  <span class="mono meta">{o.meta}</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="strip" aria-label="Datos clave">
      <dl class="wrap strip-grid">
        {
          c.values.map((v) => (
            <div>
              <dt class="mono">{v.label}</dt>
              <dd>{v.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>

  <Footer />
</Base>

<style>
  main {
    background: var(--color-ink);
  }

  /* Portada con foto */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(88svh, 820px);
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
  }
  /* Móvil: la foto ocupa la parte alta, sin quedar detrás del texto */
  .hero-photo {
    position: absolute;
    inset: 0 0 38% 0;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  /* El recorte de referencia es muy oscuro: se aclara para que la foto se vea. */
  .hero-photo :global(img) {
    filter: brightness(3.2) contrast(1.1) saturate(1.1) blur(0.7px) !important;
    object-position: 35% 22% !important;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-ink) 6%,
      rgba(10, 10, 10, 0.72) 42%,
      rgba(10, 10, 10, 0.25) 100%
    );
    pointer-events: none;
  }
  .hero-body {
    position: relative;
    z-index: 2;
    padding-block: 120px 56px;
  }
  .hero-body .eyebrow {
    color: var(--color-subtle);
  }
  h1 {
    display: grid;
    margin-bottom: 24px;
    font-size: clamp(3.2rem, 17.5vw, 10rem);
    line-height: 0.86;
  }
  .lead {
    max-width: 52ch;
    margin: 0 0 32px;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(242, 240, 235, 0.82);
  }
  .actions {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .actions .btn {
    width: 100%;
  }
  .coord {
    max-width: 100%;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  /*
    Selector: las dos opciones ocupan todo el alto visible bajo el menú (69 px).
    Móvil: una arriba y otra abajo, mitad y mitad. Escritorio: lado a lado.
    scroll-margin negativo: al llegar por el ancla, el selector queda justo bajo el menú.
  */
  .select {
    min-height: calc(100svh - 69px);
    scroll-margin-top: -19px;
    border-bottom: 1px solid var(--color-line);
  }
  .panels {
    display: grid;
    grid-template-rows: 1fr 1fr;
    min-height: calc(100svh - 69px);
  }
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 0;
    padding: 20px 20px 22px;
    overflow: hidden;
    color: var(--color-bone);
    text-decoration: none;
  }
  .panel + .panel {
    border-top: 1px solid var(--color-line);
  }
  /* Una barra roja marca la opción sobre la que estás */
  .panel::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 3;
    width: 0;
    background: var(--color-signal);
    transition: width 0.25s ease;
  }
  .panel:hover::before,
  .panel:focus-visible::before {
    width: 6px;
  }
  .panel:focus-visible {
    outline-offset: -6px;
  }
  .panel-photo {
    position: absolute;
    inset: 0;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .panel:hover .panel-photo {
    transform: scale(1.04);
  }
  .panel-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.96) 12%, rgba(10, 10, 10, 0.5) 62%, rgba(10, 10, 10, 0.6));
  }
  .panel-top,
  .panel-body {
    position: relative;
    z-index: 2;
  }
  .panel-top {
    display: grid;
    justify-items: start;
    gap: 8px;
  }
    .tag {
    padding: 3px 8px;
    border: 1px solid rgba(242, 240, 235, 0.35);
    background: rgba(10, 10, 10, 0.6);
    font-size: 10px;
  }
  .kind {
    color: var(--color-subtle);
  }
  .name {
    margin: 4px 0 8px;
    font-size: clamp(3.4rem, 15vw, 5.6rem);
    line-height: 0.88;
  }
  .text {
    max-width: 40ch;
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.45;
    color: rgba(242, 240, 235, 0.88);
  }
  .panel-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
    padding-top: 12px;
    border-top: 1px solid rgba(242, 240, 235, 0.25);
  }
  .go {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .meta {
    color: var(--color-muted);
  }

  /* Móviles de poco alto: se omite el párrafo para que cada opción siga midiendo la mitad exacta */
  @media (max-width: 899px) and (max-height: 720px) {
    .panel {
      gap: 8px;
      padding-block: 14px;
    }
    .text {
      display: none;
    }
    .name {
      font-size: clamp(2.8rem, 12vw, 4rem);
      margin-bottom: 10px;
    }
  }

  /* Franja de datos */
  .strip {
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .strip-grid {
    display: grid;
    margin-block: 0;
  }
  .strip-grid > div {
    padding: 20px 0;
    border-top: 1px solid var(--color-line);
  }
  .strip-grid > div:first-child {
    border-top: 0;
  }
  .strip dt {
    color: var(--color-muted);
  }
  .strip dd {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    /* Escritorio: la foto a la derecha, sin ampliarla más de lo que su resolución aguanta */
    .hero-photo {
      inset: 0 0 0 auto;
      width: min(54%, 760px);
      mask-image: linear-gradient(to right, transparent 0%, #000 42%);
    }
    .hero::after {
      background:
        linear-gradient(to right, var(--color-ink) 36%, rgba(10, 10, 10, 0.55) 56%, rgba(10, 10, 10, 0.1) 100%),
        linear-gradient(to top, var(--color-ink) 2%, transparent 40%);
    }
    .hero-body {
      padding-block: 160px 72px;
    }
    h1 {
      font-size: clamp(6rem, 13vw, 11.5rem);
    }
    .actions {
      grid-auto-flow: column;
      align-items: center;
      justify-content: start;
      gap: 32px;
    }
    .actions .btn {
      width: auto;
    }
    .panels {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr;
    }
    .panel {
      padding: 40px 48px 44px;
      gap: 24px;
    }
    .panel + .panel {
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }
    .name {
      font-size: clamp(5.5rem, 11vw, 10rem);
      margin: 8px 0 16px;
    }
    .text {
      font-size: 18px;
      line-height: 1.55;
      margin-bottom: 28px;
    }
    .panel-foot {
      padding-top: 18px;
    }
    .strip-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .strip-grid > div {
      padding: 28px 24px 28px 0;
      border-top: 0;
    }
    .strip-grid > div:nth-child(n + 2) {
      padding-left: 24px;
      border-left: 1px solid var(--color-line);
    }
  }
</style>
