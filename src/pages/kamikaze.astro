---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import T from '../components/T.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import LeadForm from '../components/forms/LeadForm';
import logo from '../assets/brand/kamikaze-logo-provisional.png';
import { kamikaze as c } from '../content/kamikaze';
import { site } from '../content/site';
---

<Base title={c.meta.title} description={c.meta.description} brand="kamikaze">
  <Header other={{ href: '/max', label: 'Entrenar con Max' }} />

  <main id="contenido">
    <section class="hero wrap">
      <Image
        class="hero-logo"
        src={logo}
        alt="Logo de Kamikaze Colombia (provisional)"
        width={240}
        height={240}
        loading="eager"
      />
      <h1>{c.hero.title}</h1>
      <p class="lead">{c.hero.text}</p>
      <a class="cta" href="#interesado">{c.hero.action}</a>
    </section>

    <section class="disciplines" aria-labelledby="disciplinas">
      <div class="wrap block">
        <h2 id="disciplinas" class="section-title">{c.disciplines.title}</h2>
        <ul class="discipline-list">
          {c.disciplines.items.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </section>

    <section class="wrap block about" aria-labelledby="academia">
      <div>
        <h2 id="academia" class="section-title">{c.about.title}</h2>
        <p class="copy"><T text={c.about.text} /></p>
      </div>
      <div>
        <h3 class="sub-title">{c.audience.title}</h3>
        <dl class="rows">
          {
            c.audience.items.map((i) => (
              <div>
                <dt>{i.label}</dt>
                <dd><T text={i.value} /></dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="wrap block start" aria-labelledby="empezar">
      <h2 id="empezar" class="section-title">{c.start.title}</h2>
      <div class="start-list">
        {
          c.start.items.map((i) => (
            <div class="start-item">
              <h3>{i.title}</h3>
              <p><T text={i.text} /></p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="wrap block" aria-labelledby="entrenadores">
      <h2 id="entrenadores" class="section-title">{c.coaches.title}</h2>
      <div class="coaches">
        {
          c.coaches.items.map((coach) => (
            <article class="coach">
              <PhotoPlaceholder ratio="1 / 1" note={coach.photo} />
              <h3><T text={coach.name} /></h3>
              <p class="role"><T text={coach.role} /></p>
              <p class="bio"><T text={coach.bio} /></p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="wrap block" aria-labelledby="horarios">
      <h2 id="horarios" class="section-title">{c.schedule.title}</h2>
      <table class="schedule">
        <caption class="sr-only">Horario de clases por día, hora, disciplina y nivel</caption>
        <thead>
          <tr>{c.schedule.head.map((h) => <th scope="col">{h}</th>)}</tr>
        </thead>
        <tbody>
          {
            c.schedule.rows.map((row) => (
              <tr>
                {row.map((cell, i) => (
                  <td data-label={c.schedule.head[i]}>
                    <T text={cell} />
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="wrap block venue" aria-labelledby="sede">
      <div>
        <h2 id="sede" class="section-title">{c.venue.title}</h2>
        <dl class="rows">
          {
            c.venue.items.map((i) => (
              <div>
                <dt>{i.label}</dt>
                <dd><T text={i.value} /></dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="venue-photos">
        {
          c.venue.photos.map((note, i) => (
            <div class:list={['venue-photo', { wide: i === 0 }]}>
              <PhotoPlaceholder ratio={i === 0 ? '16 / 9' : '4 / 3'} note={note} />
            </div>
          ))
        }
      </div>
    </section>

    <section id="interesado" class="signup" aria-labelledby="registro">
      <div class="wrap block signup-grid">
        <div>
          <h2 class="section-title">{c.opening.title}</h2>
          <p class="copy">{c.opening.text}</p>
          <dl class="rows opening">
            <div>
              <dt>{c.opening.date.label}</dt>
              <dd><T text={c.opening.date.value} /></dd>
            </div>
          </dl>
          <h3 id="registro" class="sub-title form-title">{c.form.title}</h3>
          <p class="copy">{c.form.text}</p>
        </div>
        <LeadForm
          client:visible
          variant="kamikaze"
          privacyHref="/privacidad"
          fallback={{ href: site.socials.kamikaze.url, label: 'escribirnos por Instagram' }}
        />
      </div>
    </section>

    <Faq id="preguntas" title={c.faq.title} items={c.faq.items} />
  </main>

  <Footer />
</Base>

<style>
  main {
    background: var(--brand-bg);
    color: var(--brand-fg);
    --ph-bg: var(--color-coal);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .sub-title {
    margin: 0 0 12px;
    font-size: 1.5rem;
    font-weight: 800;
    font-stretch: 75%;
  }
  .form-title {
    margin-top: 40px;
  }

  /* Portada */
  .hero {
    display: grid;
    gap: 24px;
    justify-items: start;
    padding-block: 40px 56px;
  }
  .hero-logo {
    width: 160px;
    height: auto;
  }
  h1 {
    margin: 0;
    max-width: 11ch;
    text-wrap: balance;
    font-size: clamp(3rem, 15vw, 7.5rem);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .lead {
    max-width: 46ch;
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 28px;
    background: var(--brand-signal);
    color: var(--brand-on-signal);
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
  }
  .cta:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Disciplinas: el gesto tipográfico de la página */
  .disciplines {
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .discipline-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .discipline-list li {
    padding-block: 6px 2px;
    border-top: 3px solid var(--color-ink);
    font-size: clamp(3.4rem, 19vw, 10rem);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .discipline-list li:last-child {
    border-bottom: 3px solid var(--color-ink);
  }

  /* Presentación y público */
  .about {
    display: grid;
    gap: 40px;
  }

  /* Cómo empezar */
  .start-list {
    display: grid;
  }
  .start-item {
    padding-block: 22px;
    border-top: 1px solid var(--brand-line);
  }
  .start-item h3 {
    margin: 0 0 6px;
    font-size: 1.5rem;
    font-weight: 800;
    font-stretch: 75%;
  }
  .start-item p {
    max-width: 46ch;
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--brand-muted);
  }

  /* Entrenadores */
  .coaches {
    display: grid;
    gap: 40px;
  }
  .coach h3 {
    margin: 20px 0 2px;
    font-size: 1.6rem;
    font-weight: 800;
    font-stretch: 75%;
  }
  .coach p {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
  }
  .coach .role {
    color: var(--brand-muted);
    margin-bottom: 8px;
  }

  /* Horarios: tabla en escritorio, filas apiladas en móvil */
  .schedule {
    width: 100%;
    border-collapse: collapse;
  }
  .schedule thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .schedule tr {
    display: grid;
    gap: 6px;
    padding-block: 16px;
    border-top: 1px solid var(--brand-line);
  }
  .schedule tbody tr:last-child {
    border-bottom: 1px solid var(--brand-line);
  }
  .schedule td {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
    align-items: baseline;
    font-size: 18px;
    font-weight: 700;
  }
  .schedule td::before {
    content: attr(data-label);
    font-size: 16px;
    font-weight: 500;
    color: var(--brand-muted);
  }

  /* Sede */
  .venue {
    display: grid;
    gap: 40px;
  }
  .venue-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .venue-photo.wide {
    grid-column: 1 / -1;
  }

  /* Próxima apertura y registro */
  .signup {
    background: var(--color-coal);
  }
  .signup-grid {
    display: grid;
    gap: 32px;
  }
  .opening {
    max-width: 52ch;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'title logo'
        'lead  logo'
        'cta   logo';
      column-gap: 64px;
      align-items: start;
      padding-block: 72px 88px;
    }
    h1 { grid-area: title; }
    .lead { grid-area: lead; }
    .cta { grid-area: cta; }
    .hero-logo {
      grid-area: logo;
      width: 340px;
    }
    .about,
    .venue,
    .signup-grid {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
    .start-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
    .coaches {
      grid-template-columns: repeat(2, minmax(0, 360px));
      gap: 64px;
    }
    .schedule thead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
    .schedule th {
      padding: 0 16px 12px 0;
      text-align: left;
      font-size: 16px;
      font-weight: 600;
      color: var(--brand-muted);
    }
    .schedule tr {
      display: table-row;
      padding: 0;
    }
    .schedule td {
      display: table-cell;
      padding: 18px 16px 18px 0;
      border-top: 1px solid var(--brand-line);
    }
    .schedule td::before {
      content: none;
    }
    .schedule tbody tr:last-child td {
      border-bottom: 1px solid var(--brand-line);
    }
  }
</style>
