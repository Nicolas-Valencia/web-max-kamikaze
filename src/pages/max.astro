---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Testimonials from '../components/Testimonials.astro';
import T from '../components/T.astro';
import RefPhoto from '../components/RefPhoto.astro';
import PlanList from '../components/PlanList.astro';
import LeadForm from '../components/forms/LeadForm';
import portrait from '../assets/reference/max-portrait.jpg';
import gallery1 from '../assets/reference/gallery-1.jpg';
import gallery2 from '../assets/reference/gallery-2.jpg';
import gallery3 from '../assets/reference/gallery-3.jpg';
import gallery4 from '../assets/reference/gallery-4.jpg';
import { max as c } from '../content/max';
import { site } from '../content/site';

/** Enlace de WhatsApp con un mensaje inicial; null si el número aún no está configurado. */
const wa = (message: string) =>
  site.whatsapp.max ? `${site.whatsapp.max}?text=${encodeURIComponent(message)}` : null;

const heroWa = wa(c.hero.whatsappMessage);
const plansWa = wa(c.plans.whatsappMessage);

const gallery = [
  { src: gallery1, ratio: '16 / 9', position: '50% 40%', area: 'a' },
  { src: gallery2, ratio: '4 / 5', position: '50% 25%', area: 'b' },
  { src: gallery3, ratio: '16 / 8', position: '50% 50%', area: 'c' },
  { src: gallery4, ratio: '16 / 8', position: '50% 40%', area: 'd' },
] as const;
---

<Base title={c.meta.title} description={c.meta.description} brand="max">
  <SiteHeader brand="max" links={c.nav} cta={c.cta} />

  <main id="contenido">
    <!-- 1. Portada tipográfica -->
    <section class="hero" aria-labelledby="titular">
      <div class="wrap hero-body">
        <h1 id="titular" class="display slam">
          {
            c.hero.lines.map((l, i) => (
              <span class="line-mask">
                <span class:list={['line', { accent: i === c.hero.lines.length - 1 }]} style={`--i:${i}`}>
                  {l}
                </span>
              </span>
            ))
          }
        </h1>
        <div class="hero-foot">
          <p class="lead">{c.hero.text}</p>
          <div class="actions">
            <a class="btn btn-primary" href="#sesion">{c.hero.primary}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Franja de datos confirmados -->
    <section class="strip" aria-label="Datos del entrenamiento">
      <dl class="wrap strip-grid">
        {
          c.strip.map((i) => (
            <div>
              <dt class="mono">{i.label}</dt>
              <dd>{i.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- 3. Filosofía y entrenador -->
    <section id="sobre" class="wrap block about" aria-labelledby="t-sobre">
      <div class="about-photo">
        <RefPhoto src={portrait} alt="Retrato de un entrenador de Muay Thai" ratio="4 / 5" position="50% 20%" />
        <div class="about-card">
          <p class="mono">{c.about.photo.label}</p>
          <p class="who">{c.about.photo.name}</p>
          <p class="role"><T text={c.about.photo.role} /></p>
        </div>
      </div>
      <div>
        <h2 id="t-sobre" class="display">
          {c.about.lines.map((l) => <span class="line">{l}</span>)}
          <span class="line">{c.about.accent}</span>
        </h2>
        <blockquote class="quote"><T text={c.about.quote} /></blockquote>
        <p class="body"><T text={c.about.text} /></p>
        <dl class="rows">
          {
            c.about.items.map((i) => (
              <div>
                <dt>{i.label}</dt>
                <dd><T text={i.value} /></dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- 4. Galería: tras la filosofía, antes de pedir nada -->
    <section id="galeria" class="wrap block" aria-labelledby="t-galeria">
      <SectionHead
        id="t-galeria"
        title={c.gallery.title}
        accent={c.gallery.accent}
      />
      <div class="gallery">
        {
          gallery.map((g, i) => (
            <figure class={`g g-${g.area}`}>
              <RefPhoto src={g.src} alt="" ratio={g.ratio} position={g.position} tag="top-right" />
              <figcaption class="mono"><T text={c.gallery.captions[i]} /></figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- 5. Método y para quién es: franja hueso -->
    <section id="metodo" class="band-bone" aria-labelledby="t-metodo">
      <div class="wrap block">
        <SectionHead id="t-metodo" title={c.how.title} accent={c.how.accent} />
        <ol class="steps">
          {
            c.how.steps.map((s, i) => (
              <li class="step">
                <span class="num" aria-hidden="true">{`0${i + 1}`}</span>
                <h3 class="display">{s.title}</h3>
                <p class="body">{s.text}</p>
              </li>
            ))
          }
        </ol>

        <div class="profiles">
          <div class="profiles-head">
            <h3 id="perfiles" class="sub-title display">{c.profiles.title} {c.profiles.accent}</h3>
            <p class="body">{c.profiles.text}</p>
          </div>
          <ul class="profile-list">
            {
              c.profiles.items.map((p) => (
                <li class="profile">
                  <h3 class="display">{p.title}</h3>
                  <p class="body">{p.text}</p>
                  <p class="goal mono"><T text={p.goal} /></p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. Sesión suelta, paquetes y lugares -->
    <section id="planes" class="wrap block" aria-labelledby="t-planes">
      <SectionHead
        id="t-planes"
        title={c.plans.title}
        accent={c.plans.accent}
        sub={c.plans.sub}
      >
        <T text={c.plans.note} />
      </SectionHead>
      <PlanList
        items={c.plans.items}
        action={c.plans.action}
        href={plansWa ?? '#sesion'}
        external={Boolean(plansWa)}
      />

      <h3 class="places-title display">{c.places.title}</h3>
      <div class="places">
        {
          c.places.items.map((p) => (
            <article class="place">
              <h4 class="display">{p.title}</h4>
              <dl class="rows">
                {
                  p.rows.map((r) => (
                    <div>
                      <dt>{r.label}</dt>
                      <dd><T text={r.value} /></dd>
                    </div>
                  ))
                }
              </dl>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 8. Testimonios -->
    <section class="wrap block" aria-labelledby="t-alumnos">
      <SectionHead
        id="t-alumnos"
        title={c.testimonials.title}
        accent={c.testimonials.accent}
      />
      <Testimonials items={c.testimonials.items} />
    </section>

    <!-- 11. Solicitud de sesión -->
    <section id="sesion" class="signup" aria-labelledby="registro">
      <div class="wrap block signup-grid">
        <div>
          <h2 id="registro" class="display">{c.form.title}</h2>
          <p class="copy">{c.form.text}</p>
        </div>
        <div class="card form-card">
          <LeadForm
            client:visible
            variant="max"
            privacyHref="/privacidad"
            fallback={heroWa ? { href: heroWa, label: 'escribirnos por WhatsApp' } : null}
          />
        </div>
      </div>
    </section>

    <!-- 12. Preguntas frecuentes -->
    <Faq id="preguntas" title={c.faq.title} accent={c.faq.accent} items={c.faq.items} />

    <!-- 13. Cierre -->
    <FinalCta
      title={c.final.title}
      accent={c.final.accent}
      text={c.final.text}
      primary={{ href: '#sesion', label: c.final.primary }}
      secondary={heroWa ? { href: heroWa, label: c.final.secondary } : null}
    />
  </main>

  <Footer />
  <StickyCta href="#sesion" label={c.cta.label} />
</Base>

<style>
  main {
    background: var(--color-ink);
  }
  .body {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .line {
    display: block;
  }

  /* Portada tipográfica. El nombre empareja con el panel de Max en el inicio. */
  .hero {
    border-bottom: 1px solid var(--color-line);
    view-transition-name: path-max;
  }
  .hero-body {
    padding-block: 56px 56px;
  }
  h1 {
    letter-spacing: -0.02em;
    margin-bottom: 40px;
    font-size: clamp(3rem, 15.5vw, 6rem);
    line-height: 0.88;
  }
  .hero-foot {
    display: grid;
    gap: 28px;
  }
  .lead {
    max-width: 50ch;
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: rgba(242, 240, 235, 0.85);
  }
  .actions {
    display: grid;
    gap: 8px;
    justify-items: stretch;
  }
  /* Franja de datos */
  .strip {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .strip-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-block: 0;
  }
  .strip-grid > div {
    padding: 20px 12px 20px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .strip-grid > div:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .strip dt {
    color: var(--color-muted);
  }
  .strip dd {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.1;
  }

  /* Filosofía */
  .about {
    display: grid;
    gap: 40px;
  }
  .about-photo {
    position: relative;
    max-width: 480px;
    border: 1px solid var(--color-line);
    padding: 12px;
    background: var(--color-card);
  }
  .about-card {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 16px 18px;
    border-left: 3px solid var(--color-bone);
    background: rgba(10, 10, 10, 0.88);
  }
  .about-card p {
    margin: 0;
  }
  .about-card .mono {
    color: var(--color-muted);
  }
  .who {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
  }
  .role {
    font-size: 15px;
    color: var(--color-muted);
  }
  .about h2 {
    margin-bottom: 28px;
    font-size: clamp(2.2rem, 8vw, 3.6rem);
  }
  .quote {
    margin: 0 0 20px;
    padding-left: 18px;
    border-left: 2px solid var(--color-line);
    font-size: 19px;
    line-height: 1.6;
  }
  .about .body {
    margin-bottom: 28px;
  }

  /* Método */
  .steps {
    display: grid;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    padding-top: 18px;
    border-top: 1px solid var(--color-bone);
  }
  .num {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 12vw, 8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.82;
    color: var(--color-signal);
  }
  .step h3,
  .card h3 {
    margin: 0 0 10px;
    font-size: 2rem;
    line-height: 1;
  }

  /* Sedes: columnas abiertas, separadas por una regla, sin caja */
  .place {
    padding-top: 22px;
    border-top: 1px solid var(--color-bone);
  }
  /* Perfiles: título en columna estrecha y filas grandes al lado (composición asimétrica) */
  .profiles {
    display: grid;
    gap: 28px;
    margin-top: 88px;
  }
  .sub-title {
    margin: 0 0 14px;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1;
  }
  .profile {
    padding-block: 26px;
    border-top: 1px solid var(--color-bone);
  }
  .profile:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .profile h3 {
    margin: 0 0 8px;
    font-size: 2.2rem;
    line-height: 1;
  }
  .profile-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .places-title {
    margin: 56px 0 20px;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
  }
  .places {
    display: grid;
    gap: 16px;
  }
  .places h4 {
    margin: 0 0 8px;
    font-size: 1.8rem;
  }

  /* Perfiles */
  .goal {
    margin: 20px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  /* Galería */
  .gallery {
    display: grid;
    gap: 12px;
  }
  .g {
    position: relative;
    margin: 0;
  }
  .g figcaption {
    position: absolute;
    left: 0;
    bottom: 12px;
    max-width: calc(100% - 24px);
    padding: 6px 12px;
    border-left: 3px solid var(--color-bone);
    background: rgba(10, 10, 10, 0.88);
    font-size: 12px;
  }

  /* Solicitud */
  .signup {
    border-block: 1px solid var(--color-line);
    background: var(--color-surface);
    --field-bg: #0c0c0c;
  }
  .signup-grid {
    display: grid;
    gap: 40px;
  }
  .signup .display {
    margin-bottom: 16px;
    font-size: clamp(2.4rem, 8vw, 3.4rem);
  }
  .form-card {
    padding: 24px;
  }

  @media (min-width: 900px) {
    .hero-body {
      padding-block: 88px 72px;
    }
    h1 {
      font-size: clamp(5rem, 9vw, 8rem);
    }
    .hero-foot {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 64px;
    }
    .actions {
      grid-auto-flow: column;
      align-items: center;
      justify-content: end;
      gap: 24px;
    }
    .strip-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .strip-grid > div {
      padding: 28px 24px 28px 0;
      border-bottom: 0;
    }
    .strip-grid > div:nth-child(n + 2) {
      padding-left: 24px;
      border-left: 1px solid var(--color-line);
    }
    .about {
      grid-template-columns: 0.85fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
    .profiles {
      grid-template-columns: 0.8fr 1.3fr;
      gap: 80px;
      align-items: start;
    }
    .profiles-head {
      position: sticky;
      top: 110px;
    }
    .places {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .gallery {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: 460px 320px;
      gap: 16px;
    }
    .g-a { grid-column: span 4; }
    .g-b { grid-column: span 2; }
    .g-c,
    .g-d { grid-column: span 3; }
    .g,
    .g :global(.ref) {
      height: 100%;
    }
    .g :global(.ref) {
      aspect-ratio: auto !important;
    }
    .signup-grid {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
    .form-card {
      padding: 36px;
    }
  }
</style>
