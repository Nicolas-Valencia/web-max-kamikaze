---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import T from '../components/T.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import LeadForm from '../components/forms/LeadForm';
import { max as c } from '../content/max';
import { site } from '../content/site';

/** Enlace de WhatsApp con un mensaje inicial; null si el número aún no está configurado. */
const wa = (message: string) =>
  site.whatsapp.max ? `${site.whatsapp.max}?text=${encodeURIComponent(message)}` : null;

const heroWa = wa(c.hero.whatsappMessage);
const plansWa = wa(c.plans.whatsappMessage);
const productsWa = wa(c.products.whatsappMessage);
---

<Base title={c.meta.title} description={c.meta.description} brand="max">
  <Header other={{ href: '/kamikaze', label: 'Ver Kamikaze' }} />

  <main id="contenido">
    <section class="hero wrap">
      <div class="hero-copy">
        <h1>{c.hero.title}</h1>
        <p class="lead">{c.hero.text}</p>
        <div class="actions">
          <a class="cta" href="#sesion">{c.hero.primary}</a>
          {
            heroWa && (
              <a class="cta-alt" href={heroWa} rel="noopener" target="_blank">
                {c.hero.whatsapp}
              </a>
            )
          }
        </div>
      </div>
      <div class="hero-photo">
        <PhotoPlaceholder note={c.hero.photo} />
      </div>
    </section>

    <section class="sheet-band" aria-label="Datos de cada sesión">
      <dl class="sheet wrap">
        {
          c.sheet.map((i) => (
            <div class="sheet-row">
              <dt>{i.label}</dt>
              <dd>{i.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="wrap block about" aria-labelledby="sobre">
      <div class="about-photo">
        <PhotoPlaceholder note={c.about.photo} />
      </div>
      <div>
        <h2 id="sobre" class="section-title">{c.about.title}</h2>
        <p class="copy"><T text={c.about.text} /></p>
        <dl class="rows">
          {
            c.about.items.map((i) => (
              <div>
                <dt>{i.label}</dt>
                <dd><T text={i.value} /></dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="wrap block" aria-labelledby="como">
      <h2 id="como" class="section-title">{c.how.title}</h2>
      <ol class="steps">
        {
          c.how.steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="wrap block" aria-labelledby="objetivos">
      <h2 id="objetivos" class="section-title">{c.goals.title}</h2>
      <ul class="goals">
        {
          c.goals.items.map((g) => (
            <li>
              <h3><T text={g.title} /></h3>
              <p><T text={g.text} /></p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap block" aria-labelledby="lugar">
      <h2 id="lugar" class="section-title">{c.places.title}</h2>
      <div class="places">
        {
          c.places.items.map((p) => (
            <div>
              <h3 class="sub-title">{p.title}</h3>
              <dl class="rows">
                {
                  p.rows.map((r) => (
                    <div>
                      <dt>{r.label}</dt>
                      <dd><T text={r.value} /></dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          ))
        }
      </div>
    </section>

    <section class="band" aria-labelledby="planes">
      <div class="wrap block">
        <h2 id="planes" class="section-title">{c.plans.title}</h2>
        <div class="plans">
          {
            c.plans.items.map((p) => (
              <article class="plan">
                <h3><T text={p.name} /></h3>
                <dl class="rows">
                  {
                    p.rows.map((r) => (
                      <div>
                        <dt>{r.label}</dt>
                        <dd><T text={r.value} /></dd>
                      </div>
                    ))
                  }
                </dl>
                {
                  plansWa && (
                    <a class="plan-link" href={plansWa} rel="noopener" target="_blank">
                      {c.plans.action}
                    </a>
                  )
                }
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="wrap block" aria-labelledby="productos">
      <h2 id="productos" class="section-title">{c.products.title}</h2>
      <p class="copy">{c.products.text}</p>
      <ul class="products">
        {
          c.products.items.map((name) => (
            <li>
              <PhotoPlaceholder ratio="1 / 1" note={`Foto de ${name.toLowerCase()}.`} />
              <h3>{name}</h3>
              <p><T text={c.products.price} /></p>
            </li>
          ))
        }
      </ul>
      {
        productsWa && (
          <a class="cta-alt" href={productsWa} rel="noopener" target="_blank">
            {c.products.action}
          </a>
        )
      }
    </section>

    <section class="wrap block" aria-labelledby="galeria">
      <h2 id="galeria" class="section-title">{c.gallery.title}</h2>
      <ul class="gallery">
        {
          c.gallery.photos.map((note) => (
            <li><PhotoPlaceholder ratio="1 / 1" note={note} /></li>
          ))
        }
      </ul>
    </section>

    <section id="sesion" class="signup" aria-labelledby="registro">
      <div class="wrap block signup-grid">
        <div>
          <h2 id="registro" class="section-title">{c.form.title}</h2>
          <p class="copy">{c.form.text}</p>
        </div>
        <LeadForm
          client:visible
          variant="max"
          privacyHref="/privacidad"
          fallback={heroWa ? { href: heroWa, label: 'escribirnos por WhatsApp' } : null}
        />
      </div>
    </section>

    <Faq id="preguntas" title={c.faq.title} items={c.faq.items} />
  </main>

  <Footer />
</Base>

<style>
  main {
    background: var(--brand-bg);
    color: var(--brand-fg);
  }
  .sub-title {
    margin: 0 0 12px;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  /* Portada */
  .hero {
    display: grid;
    gap: 32px;
    padding-block: 40px 48px;
  }
  h1 {
    margin: 0 0 20px;
    max-width: 13ch;
    text-wrap: balance;
    font-size: clamp(3.2rem, 15vw, 7.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.92;
  }
  .lead {
    max-width: 46ch;
    margin: 0 0 28px;
    font-size: 20px;
    line-height: 1.5;
  }
  .actions {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 28px;
    background: var(--brand-signal);
    color: var(--brand-on-signal);
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
  }
  .cta:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .cta-alt {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    color: inherit;
    font-size: 18px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .hero-photo {
    max-width: 420px;
  }

  /* Ficha: los datos confirmados de cada sesión */
  .sheet-band {
    border-block: 4px solid var(--brand-fg);
  }
  .sheet {
    display: grid;
    margin-block: 0;
  }
  .sheet-row {
    display: grid;
    gap: 2px;
    padding-block: 16px;
    border-top: 1px solid var(--brand-line);
  }
  .sheet-row:first-child {
    border-top: 0;
  }
  .sheet dt {
    font-size: 16px;
    font-weight: 600;
    color: var(--brand-muted);
  }
  .sheet dd {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  /* Sobre Max */
  .about {
    display: grid;
    gap: 32px;
  }
  .about-photo {
    max-width: 420px;
  }

  /* Cómo funciona: sí es una secuencia, por eso va numerado */
  .steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    padding: 22px 0 22px 64px;
    border-top: 1px solid var(--brand-line);
    counter-increment: step;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 14px;
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .steps h3 {
    margin: 0 0 6px;
    font-size: 1.4rem;
    font-weight: 800;
  }
  .steps p {
    max-width: 44ch;
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--brand-muted);
  }

  /* Objetivos: lista, no secuencia */
  .goals {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .goals li {
    display: grid;
    gap: 6px;
    padding-block: 20px;
    border-top: 1px solid var(--brand-line);
  }
  .goals li:last-child {
    border-bottom: 1px solid var(--brand-line);
  }
  .goals h3 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
  }
  .goals p {
    max-width: 46ch;
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--brand-muted);
  }

  /* Dónde entrenas */
  .places {
    display: grid;
    gap: 40px;
  }

  /* Planes */
  .band {
    border-top: 4px solid var(--brand-fg);
  }
  .plans {
    display: grid;
    gap: 40px;
  }
  .plan {
    padding-top: 16px;
    border-top: 4px solid var(--brand-fg);
  }
  .plan h3 {
    margin: 0 0 12px;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .plan-link {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    margin-top: 16px;
    padding: 0 22px;
    background: var(--brand-signal);
    color: var(--brand-on-signal);
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
  }
  .plan-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Productos */
  .products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 12px;
    margin: 28px 0;
    padding: 0;
    list-style: none;
  }
  .products h3 {
    margin: 12px 0 2px;
    font-size: 1.2rem;
    font-weight: 800;
  }
  .products p {
    margin: 0;
    font-size: 17px;
    color: var(--brand-muted);
  }

  /* Galería */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Solicitud de sesión: tema oscuro propio */
  .signup {
    background: var(--color-steel);
    color: var(--color-concrete);
    --brand-fg: var(--color-concrete);
    --brand-bg: var(--color-steel);
    --brand-muted: #aab0b3;
    --brand-line: #4a4f52;
    --brand-control: #8c9295;
    --brand-signal: var(--color-concrete);
    --brand-on-signal: var(--color-steel);
    --brand-error: #ff8a8d;
    --field-bg: #1a1c1d;
  }
  .signup-grid {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.4fr 1fr;
      gap: 72px;
      align-items: end;
      padding-block: 72px 64px;
    }
    h1 {
      max-width: none;
      font-size: clamp(4rem, 6.2vw, 5.8rem);
    }
    .actions {
      grid-auto-flow: column;
      justify-content: start;
      gap: 32px;
    }
    .sheet {
      grid-template-columns: repeat(5, 1fr);
    }
    .sheet-row {
      padding: 24px 20px 24px 20px;
      border-top: 0;
      border-left: 1px solid var(--brand-line);
    }
    .sheet-row:first-child {
      border-left: 0;
      padding-left: 0;
    }
    .about {
      grid-template-columns: 1fr 1.3fr;
      gap: 80px;
      align-items: start;
    }
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
    .steps li {
      padding: 64px 0 0;
    }
    .steps li::before {
      top: 12px;
      font-size: 3.4rem;
    }
    .goals li {
      grid-template-columns: 1fr 1.2fr;
      gap: 40px;
      align-items: baseline;
    }
    .places {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
    .plans {
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
    }
    .products {
      grid-template-columns: repeat(5, 1fr);
      gap: 24px;
    }
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .signup-grid {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }
</style>
