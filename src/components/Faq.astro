---
import T from './T.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  accent?: string;
  items: readonly { q: string; a: string }[];
}
const { id, eyebrow, title, accent, items } = Astro.props;
---

<section class="wrap block" aria-labelledby={id}>
  <SectionHead id={id} eyebrow={eyebrow} title={title} accent={accent} />
  <div class="list">
    {
      items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p><T text={f.a} /></p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: 10px;
    max-width: 900px;
  }
  details {
    border: 1px solid var(--color-line);
    background: var(--color-card);
  }
  details[open] {
    border-color: #3a3a3a;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 8px 20px;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  summary:hover {
    background: var(--color-surface);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex: none;
    font-family: var(--font-sans);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1;
  }
  details[open] summary::after {
    content: '−';
  }
  p {
    max-width: 62ch;
    margin: 0;
    padding: 0 20px 22px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>
