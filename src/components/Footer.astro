---
import { site } from '../content/site';

const disciplines = ['Muay Thai', 'Boxeo', 'BJJ', 'Lucha', 'MMA'];
---

<footer class="footer">
  <div class="wrap grid">
    <div class="about">
      <p class="word">
        <span class="accent">Max</span><span class="slash"> / </span>Kamikaze
      </p>
      <p class="blurb">
        Entrenamiento personalizado de Muay Thai y academia de deportes de combate en Armenia,
        Quindío.
      </p>
      <p class="mono where">{site.city}</p>
    </div>

    <nav aria-label="Disciplinas">
      <h2 class="mono">Disciplinas</h2>
      <ul>
        {disciplines.map((d) => <li><a href="/kamikaze#disciplinas">{d}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Navegación del sitio">
      <h2 class="mono">Sitio</h2>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/max">Max</a></li>
        <li><a href="/kamikaze">Kamikaze</a></li>
        <li><a href="/privacidad">Política de privacidad</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="mono">Contacto</h2>
      <ul>
        {
          site.whatsapp.max && (
            <li><a href={site.whatsapp.max} rel="noopener" target="_blank">WhatsApp de Max</a></li>
          )
        }
        <li>
          <a href={site.socials.max.url} rel="noopener" target="_blank">
            Instagram {site.socials.max.handle}
          </a>
        </li>
        <li>
          <a href={site.socials.kamikaze.url} rel="noopener" target="_blank">
            Instagram {site.socials.kamikaze.handle}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap legal mono">
    <span>© 2026 Max / Kamikaze</span>
    <span>Armenia, Quindío, Colombia</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-ink);
    color: var(--color-bone);
  }
  .grid {
    display: grid;
    gap: 40px;
    padding-block: 56px 40px;
  }
  .word {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    line-height: 1;
  }
  .slash {
    color: var(--color-muted);
  }
  .blurb {
    max-width: 38ch;
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .where {
    margin: 0;
    color: var(--color-subtle);
  }
  h2 {
    margin: 0 0 12px;
    font-weight: 700;
    color: var(--color-bone);
  }
  ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-subtle);
    font-size: 16px;
    text-decoration: none;
  }
  li a:hover {
    color: var(--color-bone);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px 28px;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
      gap: 56px;
      padding-block: 72px 56px;
    }
  }
</style>
