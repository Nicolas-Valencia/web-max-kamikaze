---
interface Props {
  other?: { href: string; label: string };
}
const { other } = Astro.props;
---

<header class="header">
  <a class="home" href="/">Max / Kamikaze</a>
  {other && <a class="other" href={other.href}>{other.label}</a>}
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 0 20px;
    background: var(--brand-bg);
    color: var(--brand-fg);
    border-bottom: 1px solid var(--brand-line);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: inherit;
    text-decoration: none;
  }
  .home {
    font-size: 16px;
    font-weight: 800;
    font-stretch: 62%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .other {
    font-size: 16px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (min-width: 900px) {
    .header {
      padding: 0 40px;
    }
  }
</style>
