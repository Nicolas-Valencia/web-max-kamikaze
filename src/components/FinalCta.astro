---
/** Cierre de página: titular grande con frase roja y dos acciones. */
interface Props {
  title: string;
  accent: string;
  text: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string } | null;
}
const { title, accent, text, primary, secondary } = Astro.props;
---

<section class="final" aria-labelledby="cierre">
  <div class="wrap block">
    <h2 id="cierre" class="display">
      {title}<br /><span class="accent">{accent}</span>
    </h2>
    <p class="copy">{text}</p>
    <div class="actions">
      <a class="btn btn-primary btn-arrow" href={primary.href}>{primary.label}</a>
      {
        secondary && (
          <a class="btn btn-outline" href={secondary.href} rel="noopener" target="_blank">
            {secondary.label}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .final {
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    text-align: center;
  }
  .display {
    font-size: clamp(2.6rem, 9vw, 6.2rem);
  }
  .copy {
    margin: 24px auto 32px;
    color: var(--color-bone);
    opacity: 0.8;
  }
  .actions {
    display: grid;
    gap: 12px;
    justify-items: stretch;
  }
  @media (min-width: 700px) {
    .actions {
      grid-auto-flow: column;
      justify-content: center;
      gap: 16px;
    }
  }
</style>
