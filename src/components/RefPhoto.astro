---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Foto de REFERENCIA tomada de los mockups. No es de Max ni de Kamikaze:
 * lleva una etiqueta visible y debe reemplazarse antes de publicar.
 * `npm run check:content` cuenta los archivos de src/assets/reference.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Proporción fija (ej. '16 / 9'). Con `fill` ocupa todo el contenedor. */
  ratio?: string;
  fill?: boolean;
  position?: string;
  sizes?: string;
  eager?: boolean;
  /** Conserva el color original en vez de pasar a blanco y negro. */
  color?: boolean;
  /** Dónde va la etiqueta amarilla. */
  tag?: 'top-right' | 'bottom-right';
}
const {
  src,
  alt,
  ratio = '16 / 9',
  fill = false,
  position = 'center',
  sizes,
  eager = false,
  color = false,
  tag = 'top-right',
} = Astro.props;
---

<figure
  class:list={['ref', { fill, color }]}
  data-tag={tag}
  style={fill ? undefined : `aspect-ratio: ${ratio}`}
>
  <Image
    src={src}
    alt={alt}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    style={`object-position: ${position}`}
  />
  <figcaption>Foto de referencia</figcaption>
</figure>

<style>
  .ref {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--color-card);
  }
  .fill {
    width: 100%;
    height: 100%;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(0.95);
  }
  .color img {
    filter: contrast(1.05) brightness(1.05);
  }
  figcaption {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 2px 8px;
    background: #ffe14d;
    color: #000;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    z-index: 3;
  }
  [data-tag='bottom-right'] figcaption {
    top: auto;
    bottom: 8px;
  }
</style>
